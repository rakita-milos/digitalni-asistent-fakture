# API env — kopiraj u apps/api/.env
# (Prisma CLI čita .env iz ovog foldera; ostale varijable vidi /.env.example)

DATABASE_URL=postgresql://digitalni:digitalni@localhost:5432/digitalni_asistent?schema=public
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
# Iza reverse proxy-ja (Railway/Fly, staging/produkcija) postavi 1 hop:
# TRUST_PROXY=1
