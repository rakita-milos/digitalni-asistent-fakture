{
  "name": "@digitalni-asistent/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Tipovi, Zod šeme i konstante dijeljene između API-ja, weba i mobilne aplikacije",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@digitalni-asistent/config": "workspace:*",
    "eslint": "^9.39.0",
    "vitest": "^3.2.7"
  }
}
