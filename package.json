{
  "name": "digitalni-asistent",
  "version": "0.0.0",
  "private": true,
  "description": "Digitalni Asistent — fakturisanje i naplata za mikro-poduzeća u Republici Srpskoj",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:integrations": "node tools/local-integration/run-all.mjs",
    "smoke:staging": "node tools/staging-smoke.mjs",
    "check:play": "node tools/check-play-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:deploy": "pnpm --filter api exec prisma migrate deploy",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:seed": "pnpm --filter api exec prisma db seed",
    "db:studio": "pnpm --filter api exec prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.9.0",
    "turbo": "^2.11.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.5.0": "2.5.0",
      "body-parser@<1.20.9": "1.20.9",
      "lodash@<=4.17.23": "4.18.1",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "postcss@>=8.0.0 <8.5.18": "8.5.33",
      "picomatch@>=4.0.0 <4.0.4": "4.0.7",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "tmp@<0.2.6": "0.2.7",
      "deepmerge-ts@<8.0.0": "8.0.2",
      "effect@<=3.22.0": "3.22.5",
      "qs@<6.16.1": "6.17.1"
    }
  }
}
