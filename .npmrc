# React Native (bare) sa pnpm zahtijeva "hoisted" node_modules:
# Metro i Gradle autolinking ne rade sa simlinkovanim, strogo izolovanim paketima.
node-linker=hoisted

# Monorepo: uvijek koristi lokalni workspace paket (@digitalni-asistent/shared).
link-workspace-packages=true
prefer-workspace-packages=true
save-workspace-protocol=rolling

# RN ekosistem ima labave peer zahtjeve; ne rušiti instalaciju zbog njih.
strict-peer-dependencies=false
auto-install-peers=true

engine-strict=false
