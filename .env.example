# ─────────────────────────────────────────────────────────────
# Digitalni Asistent — primjer env fajla (Sprint 0)
# Kopiraj u korijen:      cp .env.example .env
# Za API/Prisma:          cp .env.example apps/api/.env
# Za web (Next.js):       napravi apps/web/.env.local i kopiraj NEXT_PUBLIC_*
# Nikad ne commitovati .env fajlove.
# ─────────────────────────────────────────────────────────────

# Okruženje
NODE_ENV=development

# ── Seed (opciono) ──────────────────────────────────────────
# Lozinka demo vlasnika za `pnpm db:seed` (default: DemoLozinka123)
SEED_OWNER_PASSWORD=

# ── PostgreSQL 16 ────────────────────────────────────────────
# POSTGRES_* koristi docker-compose; DATABASE_URL koristi aplikacija/Prisma.
POSTGRES_USER=digitalni
POSTGRES_PASSWORD=digitalni
POSTGRES_DB=digitalni_asistent
POSTGRES_PORT=5432
DATABASE_URL=postgresql://digitalni:digitalni@localhost:5432/digitalni_asistent?schema=public

# ── Redis 7 (BullMQ: SMS, PDF, retry) ────────────────────────
REDIS_URL=redis://localhost:6379

# ── API (NestJS) ─────────────────────────────────────────────
API_PORT=3001
# CORS: nikad "*". Više origin-a razdvoji zarezom.
CORS_ORIGIN=http://localhost:3000

# ── Web (Next.js) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Auth (JWT + argon2id) ────────────────────────────────────
# Generisanje: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-in-development
JWT_REFRESH_SECRET=change-me-in-development
# access 15 min, refresh 30 dana (MASTER PROMPT §2, §10)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Ograničavanje zahtjeva (§21.5) ───────────────────────────
# login 5/min, OTP 3/5min, register 3/h — brojači su u Redis-u.
RATE_LIMIT_ENABLED=true
OTP_TTL_SECONDS=300

# ── Fajlovi (Cloudflare R2, S3 API) ──────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=digitalni-asistent
R2_ENDPOINT=
# Pre-Deployment Checklist: signed URL TTL <= 15 min
R2_SIGNED_URL_TTL_SECONDS=900

# ── SMS (provajder TBD — otvoreno pitanje) ───────────────────
# Do izbora provajdera koristi se "log" adapter (kod ide u log, ne u SMS).
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=

# ── Push (Firebase FCM) ──────────────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── ESIR / fiskalizacija ─────────────────────────────────────
# Model fiskalizacije je TBD dok operater ne odgovori (G0).
# Do tada: mock adapter (Sprint 3).
ESIR_MODE=mock
ESIR_BASE_URL=
ESIR_API_KEY=
