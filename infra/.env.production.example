# Produkcijski/staging env za infra/docker-compose.prod.yml
# Kopirati u .env (van gita) ili postaviti kao secrets na hostu/CI-ju.
# Vrijednosti ispod su PRIMJERI — obavezno ih promijeniti prije produkcije.

POSTGRES_USER=digitalni
POSTGRES_PASSWORD=promijeni-me-jaka-lozinka
POSTGRES_DB=digitalni_asistent

# Managed baza/Redis: ako koristiš Neon/Upstash, obriši postgres/redis servise u compose
# i postavi pune URL-ove ovdje.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# REDIS_URL=rediss://default:pass@host:6379

JWT_ACCESS_SECRET=promijeni-me-bar-32-nasumicna-bajta
JWT_REFRESH_SECRET=promijeni-me-drugi-bar-32-nasumicna-bajta

CORS_ORIGIN=https://app.digitalni-asistent.ba
PUBLIC_API_URL=https://api.digitalni-asistent.ba
WEB_APP_URL=https://app.digitalni-asistent.ba

RATE_LIMIT_ENABLED=true
ESIR_MODE=mock
SMS_PROVIDER=log
MAIL_PROVIDER=log

# Opciono — uključuje se kad stignu kredencijali (G12)
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
APP_RELEASE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=
